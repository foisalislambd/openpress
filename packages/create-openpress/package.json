{
  "name": "create-openpress",
  "version": "1.0.7",
  "private": true,
  "description": "Create a local OpenPress project from a GitHub checkout. Not published to npm.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "create-openpress": "./bin/create-openpress.mjs"
  },
  "files": [
    "bin",
    "lib",
    "template",
    "README.md"
  ],
  "scripts": {
    "build": "node --check bin/create-openpress.mjs && node --check lib/scaffold.mjs && node --check lib/pack-template.mjs",
    "prepack": "node ./lib/pack-template.mjs",
    "postpack": "node ./lib/pack-template.mjs --clean",
    "test": "node --test cli.spec.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/foisalislambd/openpress.git",
    "directory": "packages/create-openpress"
  },
  "engines": {
    "node": ">=20"
  }
}
